[Unit]
Description=Savvy queue worker
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/savvy
EnvironmentFile=-/etc/savvy/install.env
ExecStart=/usr/bin/php -d memory_limit=1024M /opt/savvy/artisan queue:work --sleep=3 --tries=3 --backoff=10 --max-time=3600 --memory=950
Restart=always
RestartSec=3
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
